@model WorkLogFormViewModel
<div class="mb-3">
    <label asp-for="PersianDate" class="form-label"></label>
    <input asp-for="PersianDate" class="form-control" dir="ltr" placeholder="1404/08/10" autocomplete="off" />
    <span asp-validation-for="PersianDate" class="text-danger"></span>
    <div class="form-text">تاریخ را با قالب سال/ماه/روز شمسی وارد کنید. سال‌های کبیسه پشتیبانی می‌شوند.</div>
</div>
<div class="mb-3">
    <label asp-for="Hours" class="form-label"></label>
    <input asp-for="Hours" class="form-control" type="number" step="0.25" min="0.01" max="24" inputmode="decimal" />
    <span asp-validation-for="Hours" class="text-danger"></span>
    <div class="form-text">برای ساعت کسری می‌توانید مثلاً ۶٫۵ وارد کنید.</div>
</div>
<div class="mb-3">
    <label asp-for="Description" class="form-label"></label>
    <textarea asp-for="Description" class="form-control" rows="3"></textarea>
    <span asp-validation-for="Description" class="text-danger"></span>
</div>
