@model WeeklyPlanPageViewModel
@{
    ViewData["Title"] = "برنامه هفتگی";
}

<div class="page-hero">
    <div>
        <h1>برنامه کاری هفتگی</h1>
        <p class="lede">هفته از شنبه شروع می‌شود و جمعه به پایان می‌رسد. هدف هر هفته مستقل از هفته‌های دیگر است.</p>
    </div>
</div>

<div class="panel">
    <form method="get" class="filter-bar mb-3">
        <div>
            <label class="form-label">انتخاب هفته</label>
            <select name="week" class="form-select" onchange="this.form.submit()">
                @foreach (var week in Model.WeekOptions)
                {
                    if (week.WeekStart == Model.WeekStart)
                    {
                        <option value="@week.WeekStart.ToString("yyyy-MM-dd")" selected>@week.Label</option>
                    }
                    else
                    {
                        <option value="@week.WeekStart.ToString("yyyy-MM-dd")">@week.Label</option>
                    }
                }
            </select>
        </div>
    </form>
    <p class="mb-3">بازه هفته: <strong>@Model.Report.RangeLabel</strong></p>
    <form asp-action="Index" method="post" class="form-grid">
        <input type="hidden" name="WeekStart" value="@Model.WeekStart.ToString("yyyy-MM-dd")" />
        <div>
            <label asp-for="TargetHours" class="form-label"></label>
            <input asp-for="TargetHours" class="form-control" type="number" step="0.5" min="0.01" max="168" />
            <span asp-validation-for="TargetHours" class="text-danger"></span>
        </div>
        <div>
            <button class="btn btn-primary" type="submit">ذخیره هدف هفته</button>
        </div>
    </form>
</div>

<partial name="_PeriodSummary" model="Model.Report" />
<partial name="_BudgetTable" model="Model.Report" />

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
