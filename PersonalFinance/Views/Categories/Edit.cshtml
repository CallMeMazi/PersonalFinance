@model CategoryFormViewModel
@{
    ViewData["Title"] = "ویرایش دسته";
}

<div class="page-hero">
    <div>
        <h1>ویرایش دسته‌بندی</h1>
    </div>
</div>

<div class="panel">
    <form asp-action="Edit" method="post">
        <input type="hidden" asp-for="Id" />
        <partial name="_CategoryForm" />
        <button class="btn btn-primary" type="submit">ذخیره تغییرات</button>
        <a class="btn btn-outline-light" asp-action="Index">انصراف</a>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
